[core]
	editor = code --wait
	autocrlf = false
{{- if eq .chezmoi.os "windows" }}
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe
{{- end }}
{{- $workEmail := get . "workEmail" }}
{{- if $workEmail }}
	# Machine default: the work key. Open-source directories override this via
	# the includeIf sections below (identity-open passes its own -i, which is
	# then the sole key offered thanks to IdentitiesOnly in ~/.ssh/config).
	# Deliberately NOT an IdentityFile in ~/.ssh/config: config identities are
	# offered before command-line ones, which would break the open override.
	sshCommand = ssh -i ~/.ssh/github_work_auth.pub
{{- end }}
[user]
	name = Connor Fitzgerald
{{- if $workEmail }}
	# No default identity on a multi-identity machine; email/signingkey come
	# from the includeIf sections below. useConfigOnly makes git hard-error
	# rather than guessing an identity from the hostname for repos outside them.
	useConfigOnly = true
{{- else }}
	email = "{{ .email }}"
	signingkey = {{ .signingKey }}
{{- end }}
[gpg]
	format = ssh
[gpg "ssh"]
{{- if eq .chezmoi.os "windows" }}
	program = op-ssh-sign.exe
{{- else if eq .chezmoi.os "darwin" }}
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- else }}
	program = op-ssh-sign
{{- end }}
	allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowed_signers
[commit]
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- if $workEmail }}
[alias]
	# Which identity and GitHub account does the repo I'm standing in resolve to?
	whoami = "!nu ~/.config/git/whoami.nu"
# Generated from .chezmoidata.toml, the single source of truth shared with the
# jj scopes in .config/jj/conf.d/10-identity.toml; edit the mapping there. The
# trailing slash implies /**, so these cover every repo beneath the directory.
{{- range .scopeDirs.open }}
[includeIf "gitdir:{{ . }}/"]
	path = ~/.config/git/identity-open
{{- end }}
{{- range .scopeDirs.work }}
[includeIf "gitdir:{{ . }}/"]
	path = ~/.config/git/identity-work
{{- end }}
{{- end }}

[url "git@github.com:"]
   insteadOf = https://github.com/
