#!/bin/sh
# Run the context-mode CLI (doctor, search, index, statusline) from the newest
# version in the Claude Code plugin cache, so it never drifts from the plugin.
set -eu
cache="$HOME/.claude/plugins/cache/context-mode/context-mode"
ver=$(ls "$cache" 2>/dev/null | sort -V | tail -n 1)
if [ -z "$ver" ]; then
  echo "context-mode: plugin not installed (nothing under $cache)" >&2
  exit 1
fi
exec node "$cache/$ver/cli.bundle.mjs" "$@"
