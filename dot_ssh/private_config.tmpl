{{- $workEmail := get . "workEmail" -}}
# Deployed on macOS only (see .chezmoiignore); Windows 1Password takes over
# the native OpenSSH agent pipe, so no config is needed there.
{{- if $workEmail }}
#
# This machine carries a management policy that restricts
# PubkeyAcceptedAlgorithms in /etc/ssh/ssh_config.d. ssh reads this file
# before the system one and takes the first value it sees per option, so the
# github.com block below outranks the policy; that host-specific override is
# the sanctioned fix. It MUST stay scoped to github.com: the management
# daemon rewrites this file to strip the override if it appears under Host *,
# but leaves a github.com special case alone. IdentitiesOnly with no
# IdentityFile configured means a bare `ssh git@github.com` offers no keys at
# all: keys only ever arrive via -i from git's core.sshCommand (work key as
# the machine default in ~/.gitconfig, open key via identity-open). No
# IdentityFile may be added here: config identities are offered before
# command-line ones, so it would defeat the identity-open override. That
# keeps the GitHub account a function of where the repo lives; see
# .config/git/identity-{open,work}.

Host github.com
    IdentitiesOnly yes
    PubkeyAcceptedAlgorithms +ssh-ed25519
{{- end }}

Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
