{{- if eq .chezmoi.os "windows" }}
[target.x86_64-pc-windows-msvc]
linker = "rust-lld.exe"
# rustflags = ["-C", "target-cpu=native"]

{{ end -}}
[registry]
global-credential-providers = [
{{- if eq .chezmoi.os "windows" }}
    "cargo:token-from-stdout op.exe read op://Private/crates.io/api-key",
{{- else }}
    "cargo:token-from-stdout op read op://Private/crates.io/api-key",
{{- end }}
]

# The git CLI reads core.sshCommand and ~/.ssh/config; cargo's built-in git
# does not, so it cannot authenticate after the https -> ssh URL rewrite.
[net]
git-fetch-with-cli = true
{{ if lookPath "kache" }}
[build]
rustc-wrapper = "kache"
{{ end -}}
