{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $signingKey := promptStringOnce . "signingKey" "SSH public key (e.g. ssh-ed25519 AAAA...)" -}}

[data]
email = {{ $email | quote }}
signingKey = {{ $signingKey | quote }}

[edit]
command = "code"
args = ["--wait"]

[git]
autoCommit = true
autoPush = true

[merge]
command = "nu"
args = [
    "-c",
    "cp {{ "{{" }} .Target | quote {{ "}}" }} {{ "{{" }} printf \"%s.base\" .Target | quote {{ "}}" }}; code --new-window --wait --merge {{ "{{" }} .Destination | quote {{ "}}" }} {{ "{{" }} .Target | quote {{ "}}" }} {{ "{{" }} printf \"%s.base\" .Target | quote {{ "}}" }} {{ "{{" }} .Source | quote {{ "}}" }}",
]
