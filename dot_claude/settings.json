{
  "permissions": {
    "allow": [
      "Bash(cargo xtask:*)",
      "Bash(cargo build:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "mcp__ide__getDiagnostics",
      "Bash(cargo doc:*)",
      "Bash(jj commit:*)",
      "Bash(jj diff:*)",
      "Bash(jj log:*)",
      "Bash(jj show:*)",
      "Bash(jj file show:*)"
