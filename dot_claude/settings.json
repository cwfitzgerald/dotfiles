            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File \"C:\\Users\\conno\\.claude\\toast-notification.ps1\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File \"C:\\Users\\conno\\.claude\\toast-notification.ps1\""
          }
        ]
      }
    ]
  },
  "effortLevel": "medium"
