{
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo clean:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo search:*)",
      "Bash(cargo test:*)",
      "Bash(cargo xtask:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jj commit:*)",
      "Bash(jj diff:*)",
      "Bash(jj file show:*)",
      "Bash(jj log:*)",
      "Bash(jj pr-diff:*)",
      "Bash(jj show:*)",
      "Bash(jj st:*)",
      "Bash(ls:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "mcp__ide__getDiagnostics",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:microsoft.github.io)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "defaultMode": "auto"
  },
{{- $hooksDir := printf "%s/.claude/hooks" .chezmoi.homeDir -}}
{{- $caffeine := printf "%s/caffeine.sh" $hooksDir -}}
{{- if eq .chezmoi.os "windows" -}}
{{- $caffeine = printf "powershell -ExecutionPolicy Bypass -File %s/caffeine.ps1" $hooksDir -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- $caffeine = "powershell.exe -ExecutionPolicy Bypass -File /mnt/c/Users/conno/.claude/hooks/caffeine.ps1" -}}
{{- end }}
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} reset"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} on"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} acquire"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} release"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} off"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "github@claude-plugins-official": true
  },
  "autoUpdatesChannel": "latest",
  "skipAutoPermissionPrompt": true,
  "enableWorkflows": false,
  "switchModelsOnFlag": false
}
