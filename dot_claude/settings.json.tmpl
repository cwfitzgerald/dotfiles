{
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo clean:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo search:*)",
      "Bash(cargo test:*)",
      "Bash(cargo xtask:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jj commit:*)",
      "Bash(jj diff:*)",
      "Bash(jj file show:*)",
      "Bash(jj log:*)",
      "Bash(jj pr-diff:*)",
      "Bash(jj show:*)",
      "Bash(jj st:*)",
      "Bash(ls:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "mcp__ide__getDiagnostics",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:microsoft.github.io)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "defaultMode": "auto"
  },
{{- if or (eq .chezmoi.os "windows") (eq .chezmoi.os "linux") }}
{{- $psh := "powershell" -}}
{{- $hooksDir := printf "%s/.claude/hooks" .chezmoi.homeDir -}}
{{- if eq .chezmoi.os "linux" -}}
{{- $psh = "powershell.exe" -}}
{{- $hooksDir = "/mnt/c/Users/conno/.claude/hooks" -}}
{{- end }}
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $psh }} -ExecutionPolicy Bypass -File {{ $hooksDir }}/caffeine.ps1 on"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $psh }} -ExecutionPolicy Bypass -File {{ $hooksDir }}/notify.ps1 'Task completed' complete"
          },
          {
            "type": "command",
            "command": "{{ $psh }} -ExecutionPolicy Bypass -File {{ $hooksDir }}/caffeine.ps1 off"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $psh }} -ExecutionPolicy Bypass -File {{ $hooksDir }}/notify.ps1 'Needs input' input"
          }
        ]
      }
    ]
  },
{{- end }}
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "github@claude-plugins-official": true
  },
  "autoUpdatesChannel": "latest",
  "skipAutoPermissionPrompt": true
}
