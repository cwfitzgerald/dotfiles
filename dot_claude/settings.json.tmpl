  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File {{ .chezmoi.homeDir }}/.claude/hooks/caffeine.ps1 on"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File C:\\/Users/conno/.claude/hooks/notify.ps1 'Task completed' complete"
          },
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File {{ .chezmoi.homeDir }}/.claude/hooks/caffeine.ps1 off"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File {{ .chezmoi.homeDir }}/.claude/hooks/notify.ps1 'Needs input' input"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "github@claude-plugins-official": true
  },
  "autoUpdatesChannel": "latest"
}