{
  {{- /* Mirrors dot_codex/rules/default.rules. Claude has no "send to the
         classifier" decision, so a Codex `prompt` carve-out is expressed by
         leaving the command unmatched. Where Codex allows a whole binary but
         prompts for one subcommand (jj util exec, git -c / bisect run /
         submodule foreach, uv run <shell>), the safe subcommands are listed
         one by one instead. */ -}}
  {{- $jj := list "abandon" "absorb" "bookmark" "commit" "describe" "diff" "diffedit"
        "duplicate" "edit" "evolog" "file" "fix" "git fetch" "git push" "git remote"
        "help" "interdiff" "log" "metaedit" "new" "next" "op" "parallelize" "pr-diff"
        "prev" "rebase" "redo" "resolve" "restore" "revert" "root" "show" "sign"
        "simplify-parents" "split" "squash" "st" "status" "tag" "undo" "unsign"
        "version" "workspace" "ws-rm" -}}
  {{- $git := list "add" "apply" "blame" "branch" "cat-file" "checkout" "cherry-pick"
        "clone" "commit" "config" "describe" "diff" "fetch" "for-each-ref" "grep"
        "init" "lfs" "log" "ls-files" "ls-remote" "merge" "merge-base" "mv" "name-rev"
        "pull" "push" "range-diff" "rebase" "reflog" "remote" "reset" "restore"
        "rev-list" "rev-parse" "revert" "rm" "shortlog" "show" "show-ref" "stash"
        "status" "submodule status" "submodule update" "submodule init" "switch"
        "tag" "whoami" "worktree" -}}
  {{- $gh := list "pr view" "pr list" "pr diff" "pr checks" "pr status"
        "issue view" "issue list" "issue status"
        "run view" "run list" "run watch"
        "workflow view" "workflow list"
        "repo view" "repo list"
        "search code" "search commits" "search issues" "search prs" "search repos"
        "release view" "release list" -}}
  {{- $bare := list "cargo" "just" "rg" "find" "sed" "go" "gofmt" "pytest" "ruff"
        "mypy" "pyright" "jq" -}}
  {{- $uv := list "sync" "lock" "add" "remove" "init" "venv" "build" "tree" "export" "pip" -}}
  {{- $npm := list "ci" "install" "run" "test" -}}
  {{- $pnpm := list "install" "run" "test" }}
  "permissions": {
    "allow": [
      {{- range $c := $jj }}
      "Bash(jj {{ $c }}:*)",
      "Bash(jj --no-pager {{ $c }}:*)",
      {{- end }}
      {{- range $c := $git }}
      "Bash(git {{ $c }}:*)",
      "Bash(git --no-pager {{ $c }}:*)",
      {{- end }}
      {{- range $c := $gh }}
      "Bash(gh {{ $c }}:*)",
      {{- end }}
      {{- range $c := $bare }}
      "Bash({{ $c }}:*)",
      {{- end }}
      {{- range $c := $uv }}
      "Bash(uv {{ $c }}:*)",
      {{- end }}
      {{- range $c := $npm }}
      "Bash(npm {{ $c }}:*)",
      {{- end }}
      {{- range $c := $pnpm }}
      "Bash(pnpm {{ $c }}:*)",
      {{- end }}
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "mcp__ide__getDiagnostics",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:microsoft.github.io)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "defaultMode": "auto"
  },
{{- $hooksDir := printf "%s/.claude/hooks" .chezmoi.homeDir -}}
{{- /* pythonw, not python: the hook harness spawns commands without a console,
       and a console-subsystem child then flashes a new console window. */ -}}
{{- $caffeine := printf "pythonw %s/caffeine.py" $hooksDir -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $caffeine = printf "python3 %s/caffeine.py" $hooksDir -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- /* WSL: drive the Windows-side script so the keeper holds the host's wake lock */ -}}
{{- $caffeine = "pythonw.exe C:/Users/conno/.claude/hooks/caffeine.py" -}}
{{- end }}
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} reset"
          }
        ]
      },
      {{- /* context-mode's launcher injects this entry at runtime (its plugin-cache
             self-heal); mirror it exactly so apply and the plugin stop fighting. */}}
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{ .chezmoi.homeDir }}/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} on"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} touch"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} interrupt"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} acquire"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} release"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} off"
          }
        ]
      }
    ],
{{- /* Stop does not fire on an Esc, and an API error fires StopFailure in its
       place. Without these three the hold survives a cancel until it expires. */}}
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} off"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} off"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} reset"
          }
        ]
      }
    ]
  },
  {{/* linear tracks work issues, so enable it only where a work identity exists. */ -}}
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "context-mode@context-mode": true{{ if get . "workEmail" }},
    "linear@claude-plugins-official": true
    {{- end }}
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "git",
        "url": "https://github.com/mksglu/context-mode.git"
      }
    }
  },
  "autoCompactWindow": 430000,
  "autoUpdatesChannel": "latest",
  "skipAutoPermissionPrompt": true,
  "enableWorkflows": false,
  "switchModelsOnFlag": false
}
