{
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo clean:*)",
      "Bash(cargo deny:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo search:*)",
      "Bash(cargo test:*)",
      "Bash(cargo xtask:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jj commit:*)",
      "Bash(jj diff:*)",
      "Bash(jj file show:*)",
      "Bash(jj log:*)",
      "Bash(jj pr-diff:*)",
      "Bash(jj show:*)",
      "Bash(jj st:*)",
      "Bash(ls:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "mcp__ide__getDiagnostics",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:microsoft.github.io)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "defaultMode": "auto"
  },
{{- $hooksDir := printf "%s/.claude/hooks" .chezmoi.homeDir -}}
{{- /* pythonw, not python: the hook harness spawns commands without a console,
       and a console-subsystem child then flashes a new console window. */ -}}
{{- $caffeine := printf "pythonw %s/caffeine.py" $hooksDir -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $caffeine = printf "python3 %s/caffeine.py" $hooksDir -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- /* WSL: drive the Windows-side script so the keeper holds the host's wake lock */ -}}
{{- $caffeine = "pythonw.exe C:/Users/conno/.claude/hooks/caffeine.py" -}}
{{- end }}
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} reset"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} on"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} touch"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} interrupt"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} acquire"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} release"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} off"
          }
        ]
      }
    ],
{{- /* Stop does not fire on an Esc, and an API error fires StopFailure in its
       place. Without these three the hold survives a cancel until it expires. */}}
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} off"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} off"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} reset"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": false,
    "github@claude-plugins-official": true
  },
  "autoUpdatesChannel": "latest",
  "skipAutoPermissionPrompt": true,
  "enableWorkflows": false,
  "switchModelsOnFlag": false
}
