{{- $hooksDir := printf "%s/.codex/hooks" .chezmoi.homeDir -}}
{{- /* pythonw, not python: the hook harness spawns commands without a console,
       and a console-subsystem child then flashes a new console window. */ -}}
{{- $caffeine := printf "python3 '%s/caffeine.py'" $hooksDir -}}
{{- if eq .chezmoi.os "windows" -}}
{{- $caffeine = printf "pythonw '%s/caffeine.py'" $hooksDir -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- /* WSL: drive the Windows-side script so the keeper holds the host's wake lock */ -}}
{{- $caffeine = "pythonw.exe 'C:/Users/conno/.codex/hooks/caffeine.py'" -}}
{{- end -}}
{{- /* Codex supports exactly 11 events (HookEventName in the app-server
       protocol), keyed PascalCase, and the config struct is deny_unknown_fields
       -- an unrecognized key rejects this whole file. Claude Code's
       Notification, StopFailure and PostToolUseFailure have no Codex
       equivalent, so the interrupt signals wired on that side are unavailable
       here; SessionEnd plus the rolling expiry are the backstop. */ -}}
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} reset"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} reset"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} on"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} touch"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} acquire"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} release"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} off"
          }
        ]
      }
    ]
  }
}
