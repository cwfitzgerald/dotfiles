{{- $hooksDir := printf "%s/.codex/hooks" .chezmoi.homeDir -}}
{{- /* pythonw, not python: the hook harness spawns commands without a console,
       and a console-subsystem child then flashes a new console window. */ -}}
{{- $caffeine := printf "python3 '%s/caffeine.py'" $hooksDir -}}
{{- $notify := printf "'%s/notify.sh'" $hooksDir -}}
{{- if eq .chezmoi.os "windows" -}}
{{- $caffeine = printf "pythonw '%s/caffeine.py'" $hooksDir -}}
{{- $notify = printf "powershell -ExecutionPolicy Bypass -File '%s/notify.ps1'" $hooksDir -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- /* WSL: drive the Windows-side script so the keeper holds the host's wake lock */ -}}
{{- $caffeine = "pythonw.exe 'C:/Users/conno/.codex/hooks/caffeine.py'" -}}
{{- $notify = "powershell.exe -ExecutionPolicy Bypass -File '/mnt/c/Users/conno/.codex/hooks/notify.ps1'" -}}
{{- end -}}
{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} on"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $notify }} 'Task completed' complete"
          },
          {
            "type": "command",
            "command": "{{ $caffeine }} off"
          }
        ]
      }
    ]
  }
}
