{{- $hooksDir := printf "%s/.codex/hooks" .chezmoi.homeDir -}}
{{- $caffeine := printf "'%s/caffeine.sh'" $hooksDir -}}
{{- $notify := printf "'%s/notify.sh'" $hooksDir -}}
{{- if eq .chezmoi.os "windows" -}}
{{- $caffeine = printf "powershell -ExecutionPolicy Bypass -File '%s/caffeine.ps1'" $hooksDir -}}
{{- $notify = printf "powershell -ExecutionPolicy Bypass -File '%s/notify.ps1'" $hooksDir -}}
{{- else if eq .chezmoi.os "linux" -}}
{{- $hooksDir = "/mnt/c/Users/conno/.codex/hooks" -}}
{{- $caffeine = printf "powershell.exe -ExecutionPolicy Bypass -File '%s/caffeine.ps1'" $hooksDir -}}
{{- $notify = printf "powershell.exe -ExecutionPolicy Bypass -File '%s/notify.ps1'" $hooksDir -}}
{{- end -}}
{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $caffeine }} on"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{ $notify }} 'Task completed' complete"
          },
          {
            "type": "command",
            "command": "{{ $caffeine }} off"
          }
        ]
      }
    ]
  }
}
