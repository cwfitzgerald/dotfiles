{
  "theme": "theme.json",
  "rows": [
    {
      "left": [
        { "padding": 0 },
        { "separator": "round" },
        "read_only",
        { "cwd": { "max_length": 60, "wanted_seg_num": 5, "resolve_symlinks": false } },
        { "padding": 2 },
        { "git": { "status_timeout_ms": 250 } },
        { "pr": { "status": true } }
      ],
      "right": [
        { "last_cmd_duration": { "min_run_time": 0 } },
        { "time": { "format": "%a %H:%M:%S" } },
        { "padding": 0 }
      ]
    },
    {
      "left": [
        { "padding": 0 },
        { "separator": "round" },
        "cmd",
        { "padding": 1 }
      ],
      "right": [
        { "separator": "round" },
        "nvm",
        "java",
        "python_env",
        "cargo",
        { "padding": 1 }
      ]
    }
  ]
}
