$env.config.buffer_editor = [{{ if eq .chezmoi.os "windows" }}"code.cmd"{{ else }}"code"{{ end }}, "--wait"]
$env.config.show_banner = false

# Written by env.nu; empty on machines without mise.
use ($nu.default-config-dir | path join "mise.nu")

# jj speaks clap's dynamic completion protocol; the fish wire format is
# value<TAB>description lines, which maps directly onto nushell records.
let jj_completer = {|spans: list<string>|
    let spans = if $spans.1? == "ws-rm" {
        ["jj" "workspace" "forget"] | append ($spans | skip 2)
    } else {
        $spans
    }
    with-env { COMPLETE: fish } { ^jj -- ...$spans }
    | lines
    | each {|line|
        let parts = $line | split row "\t"
        { value: $parts.0, description: ($parts | get 1? | default "") }
    }
}

$env.config.completions.external.completer = {|spans: list<string>|
    match $spans.0 {
        "jj" => { do $jj_completer $spans }
        _ => null
    }
}
{{ if eq .chezmoi.os "windows" }}
# Update all important winget packages
def update-all [] {
    winget import -i ($nu.default-config-dir | path join "vcpkg.json")
}
{{- end }}

$env.DIGITALOCEAN_ACCESS_TOKEN = "op://Infrastructure/Digital Ocean/credential"

def --wrapped doctl [...args: string] {
    op run -- doctl ...$args
}

# Launch Claude Code against a local llama-server, isolated from upstream config.
def local-claude [
    args: list<string> = []                      # claude args as a list
    --url: string = "http://192.168.1.186:8001"  # llama-server base URL
    --model: string = "unsloth/Qwen3.6-35B-A3B"  # must match --alias on llama-server
    --token: string = "sk-local"
    --config-dir: string = "~/.claude-local"
] {
    let cfg = ($config_dir | path expand)
    mkdir $cfg

    with-env {
        ANTHROPIC_BASE_URL: $url
        ANTHROPIC_AUTH_TOKEN: $token
        ANTHROPIC_API_KEY: $token
        ANTHROPIC_MODEL: $model
        CLAUDE_CODE_ATTRIBUTION_HEADER: "0"
        CLAUDE_CONFIG_DIR: $cfg
    } {
        ^claude ...$args
    }
}

# Control the sleep-preventer hook. Passes args straight through to the script,
# so: `caffeine status`, `caffeine on`, `caffeine off`, `caffeine reset`, etc.
def --wrapped caffeine [...args: string] {
    let script = ($nu.home-dir | path join ".claude" "hooks" "caffeine.py")
    ^python3 $script ...$args
}
