# them for future reference.

{{ if lookPath "fnm" }}
# fnm (Fast Node Manager)
#
# fnm has no native nushell support, so we wire it up by hand. fnm keeps a
# per-shell "multishell" junction that it re-points at the active Node version;
# `fnm env --json` only emits the FNM_* vars (NOT PATH), so we must prepend that
# junction to PATH ourselves. The PWD hook runs `fnm use` (reading
# .node-version/.nvmrc), which re-points the junction in place — no PATH edits of
# our own are needed to switch versions, only this initial prepend.
fnm env --json | from json | load-env
$env.PATH = (
    $env.PATH
    | (if (($in | describe) =~ '^list') { $in } else { $in | split row (char esep) })
    | prepend $env.FNM_MULTISHELL_PATH
)

$env.config.hooks.env_change.PWD = (
    $env.config.hooks.env_change.PWD? | default []
    | append {|| if (['.node-version' '.nvmrc'] | any {|f| $f | path exists}) { try { ^fnm use o+e>| ignore } } }
)
{{ end }}
