{{ if lookPath "fnm" }}
# fnm (Fast Node Manager)
#
# fnm has no native nushell use-on-cd, and on Windows its per-shell multishell
# junction is unexecutable here: the junction's print-name carries a raw `\??\`
# NT-namespace prefix that CreateProcess rejects ("The system cannot find the
# path specified"), even though the path resolves fine. So we let fnm do the
# version-switching, then resolve the junction chain to the real install dir and
# put THAT (not the junction) on PATH, driven from a PWD hook.
fnm env --json | from json | load-env

# Immediate junction/symlink target of `p`, or null if `p` is not a reparse
# point. A junction lists as a single row whose name is `p` itself; a real
# directory lists its children (names != p).
def _fnm_link_target [p] {
    let rows = (try { ls -l $p } catch { null })
    if ($rows == null) or (($rows | length) != 1) { return null }
    let f = ($rows | first)
    if (($f.name | path expand) == ($p | path expand)) and ($f.target? != null) and ($f.target != "") {
        $f.target
    } else {
        null
    }
}

# Follow links until we reach the real (executable) directory.
def _fnm_resolve [p] {
    let t = (_fnm_link_target $p)
    if ($t == null) { $p } else { _fnm_resolve $t }
}

def --env _fnm_activate [] {
    let has_vf = (['.node-version' '.nvmrc' 'package.json'] | any {|f| ($f | path exists)})
    # Point fnm's session junction at this dir's version (no-op without a file).
    if $has_vf { do { ^fnm use --silent-if-unchanged } | complete | ignore }

    let real = (_fnm_resolve $env.FNM_MULTISHELL_PATH)
    if ($real != null) and (($real | path join 'node.exe') | path exists) {
        let ver_root = ($env.FNM_DIR | path join 'node-versions')
        $env.PATH = (
            $env.PATH
            | where {|p| ($p != $real) and (not ($p | str starts-with $ver_root)) }
            | prepend $real
        )
    }
}

_fnm_activate
$env.config.hooks.env_change.PWD = (
    $env.config.hooks.env_change.PWD? | default []
    | append {|before, after| _fnm_activate }
)
{{ end }}
